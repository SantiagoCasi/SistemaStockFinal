@model SistemaStock.Models.ViewModels.Movimiento.OperacionStockSalidaViewModel
@{
    ViewData["Title"] = "Registrar Salida";
    ViewData["SubTitle"] = "Registrar Salida de Stock";
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form asp-action="Salida" method="post">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="idProducto" class="form-label"></label>
                <select asp-for="idProducto" class="form-select" asp-items="Model.Productos">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="idProducto" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="idDepositoOrigen" class="form-label"></label>
                <select asp-for="idDepositoOrigen" class="form-select" asp-items="Model.Depositos">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="idDepositoOrigen" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Cantidad" class="form-label"></label>
                <input asp-for="Cantidad" class="form-control" />
                <span asp-validation-for="Cantidad" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="idCliente" class="form-label"></label>
                <select asp-for="idCliente" class="form-select" asp-items="Model.Clientes">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="idCliente" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Observaciones" class="form-label"></label>
                <textarea asp-for="Observaciones" class="form-control"
                          rows="3"></textarea>
                <span asp-validation-for="Observaciones" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="card-footer">
        <button type="submit" class="btn btn-primary">Registrar Salida</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </div>
</form>
