@model IEnumerable<SistemaStock.Models.ViewModels.ProductoViewModel>
@{
    ViewData["Title"] = "Productos";
    ViewData["SubTitle"] = "Listado de Productos";
}
@* Preguntamos si existe la clave "Ok" en TempData *@
@if (TempData["Ok"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Ok"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@* Alerta de Error *@
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form method="get" class="card p-4 mt-3 mb-3">
    <div class="row g-3">
        <div class="col-md-3">
            <input type="text" name="buscar" class="form-control" placeholder="Buscar..." />
        </div>
        <div class="col-md-3">
            <select name="buscarCategoria" class="form-select" asp-items="ViewBag.Categorias">
                <option value="">Todas las categorías</option>
            </select>
        </div>
        <div class="col-md-3 d-flex align-items-end gap-2">
            <button type="submit" class="btn btn-secondary w-100">Buscar</button>
        </div>
    </div>
</form>

<div class="d-flex justify-content-end align-items-center mb-3">
    <a asp-action="Create" class="btn btn-sm btn-outline-primary" title="Crear">
        <i class="bi bi-plus"></i> Nuevo Producto
    </a>
</div>

<div class="table-responsive">
    <table class="table table-striped align-middle" id="miTabla">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Codigo)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Nombre)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Descripcion)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.PrecioCosto)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.PrecioVenta)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.idCategoria)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.UnidadDeMedida)
                </th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(model => item.Codigo)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.Nombre)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.Descripcion)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.PrecioCosto)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.PrecioVenta)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.CategoriaNombre)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.UnidadDeMedida)
                    </td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@item.id"
                           class="btn btn-sm btn-outline-primary" title="Ver">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a asp-action="Edit" asp-route-id="@item.id"
                           class="btn btn-sm btn-outline-warning" title="Editar">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form asp-action="Delete" asp-route-id="@item.id" method="post" class="form-eliminar d-inline"
                              data-nombre="@item.Nombre">
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
